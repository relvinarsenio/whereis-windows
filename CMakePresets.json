{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "description": "Base configuration for Windows builds.",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "release",
      "displayName": "Release (x64)",
      "description": "Optimized build with tests and hardening.",
      "inherits": "windows-base",
      "cacheVariables": {
        "WHEREIS_BUILD_PROFILE": "Release",
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "WHEREIS_ENABLE_IPO": "ON",
        "WHEREIS_ENABLE_HARDENING": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (x64)",
      "description": "Development build with tests and hardening.",
      "inherits": "windows-base",
      "cacheVariables": {
        "WHEREIS_BUILD_PROFILE": "Debug",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "WHEREIS_ENABLE_IPO": "OFF",
        "WHEREIS_ENABLE_HARDENING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "displayName": "Build Release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "displayName": "Build Debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "displayName": "Test Release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "displayName": "Test Debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "release",
      "displayName": "Build and Test Release",
      "description": "Runs configure, build, and test steps for the Release build.",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    },
    {
      "name": "debug",
      "displayName": "Build and Test Debug",
      "description": "Runs configure, build, and test steps for the Debug build.",
      "steps": [
        {
          "type": "configure",
          "name": "debug"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "test",
          "name": "debug"
        }
      ]
    }
  ]
}
